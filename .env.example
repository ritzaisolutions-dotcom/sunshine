MISTRAL_API_KEY=

# Shared keyword to open Sunshine (server-only). When set, shows a lock screen.
SUNSHINE_ACCESS_KEY=

# Supabase — auto cloud vault for the single shared Sunshine user
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the one vault (optional; defaults to sunshine-noorie-primary)
SUNSHINE_VAULT_KEY=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:)
VAPID_SUBJECT=mailto:sunshine@local.dev

# Protects /api/cron/reminders (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=
