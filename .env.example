MISTRAL_API_KEY=

# Shared keyword to open Sunshine (server-only). When set, shows a lock screen.
SUNSHINE_ACCESS_KEY=

# Supabase — auto cloud vault for the single shared Sunshine user
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the one vault (optional; defaults to sunshine-noorie-primary)
SUNSHINE_VAULT_KEY=
